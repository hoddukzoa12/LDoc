{
  "anchor": "물품공급계약서",
  "note": "the model reads the parties, the goods, the price and the due date, and finds each by what surrounds it, so a name masked by hand comes back as its placeholder and a name sent as written as a quote; it also points at the supply date, which the form asks once 거래 형태 is 1회성 공급",
  "answers": [
    { "field": "creditor_type", "option": "corporation" },
    { "field": "debtor_type", "option": "corporation" },
    { "field": "trade_type", "option": "one_time" },
    { "field": "goods", "find": "을에게 (.+?)를 공급" },
    { "field": "total", "find": "대금은 (.+?)\\(부가가치세" },
    { "field": "vat", "option": "included" },
    { "field": "due_on", "find": "대금을 (.+?)까지" },
    { "field": "creditor_name", "find": "공급자\\(갑\\): (.+?) \\(대표이사" },
    { "field": "creditor_id", "find": "법인등록번호 (\\S+)" },
    { "field": "creditor_address", "find": "주소: (.+?), 전화" },
    { "field": "creditor_phone", "find": "전화 (\\S+)" },
    { "field": "debtor_name", "find": "구매자\\(을\\): (.+?) \\(대표이사" },
    { "field": "debtor_address", "find": "구매자\\(을\\)[^\\n]*\\n\\s*주소: (.+)" },
    { "field": "supplied_on", "find": "제3조\\(인도\\) 갑은 (.+?) 을의" }
  ]
}
