#!/usr/bin/env bash
# Builds and tests LDoc in an instabox sandbox instead of on this machine.
#
#   scripts/box up            create or wake the sandbox, install build deps
#   scripts/box sync          copy the working tree to the sandbox
#   scripts/box run <cmd...>  sync, then run a shell command in the project
#   scripts/box test          sync, then run every check (pnpm run check)
#   scripts/box build         sync, then build the desktop app
#   scripts/box e2e           sync, build, drive the real app, pull e2e-out/
#   scripts/box icons         generate the app icons from assets/icon.svg and copy them back
#   scripts/box fmt           format the Rust code on the sandbox and copy it back
#   scripts/box pull <path>   copy a file or directory back, relative to the project
#   scripts/box down          pause the sandbox
set -euo pipefail

export INSTABOX_NO_UPDATE_CHECK=1
BOX="${LDOC_BOX:-ldoc-dev}"
REMOTE_DIR="ldoc"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

box_state() {
  instabox ls --output table 2>/dev/null | awk -v name="$BOX" '$1 == name { print $2 }'
}

# Runs a shell string in a sandbox directory and exits with its exit code.
# exec caps a command at 10 minutes, so this goes through a background job.
remote() {
  local job
  job="$(instabox exec --background "$BOX" --cwd "$1" -- "$2" 2>/dev/null)"
  instabox jobs logs "$BOX" "$job" -f
}

up() {
  case "$(box_state)" in
    Running) ;;
    "") instabox create --name "$BOX" --template agent-browser --no-vault --secrets none --meta project=ldoc ;;
    *) instabox resume "$BOX" ;;
  esac
  instabox push "$BOX" "$ROOT/scripts/box-setup.sh" /tmp/box-setup.sh >/dev/null
  remote /tmp 'bash /tmp/box-setup.sh'
}

sync() {
  [ "$(box_state)" = Running ] || up
  # Build caches stay on the sandbox. Everything else is replaced so deleted
  # files do not linger there.
  instabox exec "$BOX" -- "mkdir -p ~/$REMOTE_DIR && find ~/$REMOTE_DIR -mindepth 1 -maxdepth 1 ! -name target ! -name node_modules ! -name e2e-out -exec rm -rf {} +"
  instabox push "$BOX" "$ROOT/" "$REMOTE_DIR" --all >/dev/null
}

run() {
  remote "$REMOTE_DIR" "$*"
}

pull() {
  local path="$1"
  mkdir -p "$ROOT/$(dirname "$path")"
  rm -rf "${ROOT:?}/$path"
  instabox pull "$BOX" "$REMOTE_DIR/$path" "$ROOT/$path" >/dev/null
}

pull_lockfiles() {
  pull Cargo.lock
  pull pnpm-lock.yaml
}

# The checks regenerate the TypeScript bindings and the adapter test fixture.
pull_generated() {
  pull_lockfiles
  pull src/bindings
  pull src/fixtures
}

# Pulls e2e-out/ whether or not the run passed, then exits with the run's code.
e2e() {
  local status=0
  run 'pnpm install && pnpm tauri build --no-bundle && pnpm run e2e' || status=$?
  pull e2e-out
  return "$status"
}

command="${1:-}"
shift || true

case "$command" in
  up) up ;;
  sync) sync ;;
  run) sync && run "$@" ;;
  test) sync && run 'pnpm install && pnpm run check' && pull_generated ;;
  build) sync && run 'pnpm install && pnpm tauri build --no-bundle' && pull_lockfiles ;;
  e2e) sync && e2e ;;
  icons) sync && run 'pnpm install && pnpm tauri icon assets/icon.svg && rm -rf src-tauri/icons/android src-tauri/icons/ios' && pull src-tauri/icons ;;
  fmt) sync && run 'cargo fmt' && pull crates && pull src-tauri/src ;;
  pull) pull "$1" ;;
  down) instabox suspend "$BOX" ;;
  *) sed -n '2,14p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
